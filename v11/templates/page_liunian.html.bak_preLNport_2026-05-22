<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<title>Lin Ru Yi, 流年 Prediksi Tahunan</title>
<link rel="stylesheet" href="style.css">
<style>
  /* PAGE-SPECIFIC: Liu Nian Prediksi Tahunan (V7 Phase 2A) */
  .content-liunian {
    display: grid;
    grid-template-rows: repeat(auto-fit, 1fr);
    gap: 3mm;
    overflow: hidden;
  }
  .ln-card {
    background: var(--bg-card);
    border: 0.3mm solid var(--gold-soft);
    border-radius: 2mm;
    padding: 3mm 5mm;
    display: grid;
    grid-template-columns: 36mm 1fr;
    gap: 5mm;
    align-items: center;
    overflow: hidden;
    position: relative;
  }
  .ln-card.empty { display: none; }
  .ln-card::before {
    content: ''; position: absolute;
    top: -8mm; right: -8mm;
    width: 24mm; height: 24mm;
    background-color: transparent;
    background-image: radial-gradient(circle, rgba(201,169,97,0.06) 0%, transparent 70%);
    pointer-events: none;
  }
  .ln-left {
    border-right: 0.3mm solid var(--gold-soft);
    padding-right: 4mm;
    display: flex; flex-direction: column;
    align-items: flex-start; justify-content: center;
    gap: 0.6mm;
  }
  .ln-eyebrow {
    font-size: 6.2pt; color: var(--gold);
    letter-spacing: 2px; text-transform: uppercase; font-weight: 600;
  }
  .ln-tahun {
    font-family: 'Playfair Display', serif;
    font-size: 22pt; color: var(--red);
    font-weight: 700; line-height: 1; letter-spacing: 0.5px;
  }
  .ln-meta-row {
    display: flex; gap: 2mm; align-items: center;
    margin-top: 0.5mm; flex-wrap: wrap;
  }
  .ln-umur {
    font-size: 7pt; color: var(--text);
    background: rgba(201,169,97,0.12);
    padding: 0.4mm 2mm; border-radius: 4mm;
    border: 0.15mm solid var(--gold-soft);
    font-weight: 600;
  }
  .ln-ganzhi {
    font-family: 'Noto Serif TC', serif;
    font-size: 11pt; color: var(--red);
    font-weight: 700; letter-spacing: 1px;
  }
  .ln-right {
    display: flex; flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  .ln-prose {
    font-size: 7.2pt; color: var(--text);
    line-height: 1.5; text-align: justify;
    overflow: hidden;
  }
</style>
</head>
<body>
<section class="page">

  <!-- KEPALA -->
  <header class="page-header">
    <div class="h-num">{{PAGE_NUM_PADDED}}</div>
    <div class="h-titles">
      <div class="h-cn">流 年</div>
      <div class="h-id">Prediksi Tahunan</div>
    </div>
    <div class="h-section">Bagian I · BaZi · Sambungan Da Yun</div>
  </header>

  <!-- BAR SUBJEK -->
  <div class="subject-bar">
    <div class="subject-shio"><img src="Babi-Merah.svg" alt="Babi"></div>
    <div class="subject-meta">
      <div class="subject-name">Lin Ru Yi · <span style="font-family:'Noto Serif TC',serif;color:var(--red)">亥 Babi</span></div>
      <div class="subject-detail">30 Mei 1995 · 10:35 · Wanita · 民國 84 年 5 月 2 日</div>
    </div>
    <div class="subject-dm">
      <div class="label">流 年 Prediksi</div>
      <div class="value">Prediksi Tahunan</div>
    </div>
  </div>

  <!-- KONTEN -->
  <main class="content content-liunian" data-card-count="5">

    <div class="ln-card empty" data-slot="0">
      <div class="ln-left">
        <div class="ln-eyebrow">流 年</div>
        <div class="ln-tahun">2026</div>
        <div class="ln-meta-row">
          <span class="ln-umur">63 tahun</span>
          <span class="ln-ganzhi">丙午</span>
        </div>
      </div>
      <div class="ln-right">
        <div class="ln-prose">—</div>
      </div>
    </div>

    <div class="ln-card empty" data-slot="1">
      <div class="ln-left">
        <div class="ln-eyebrow">流 年</div>
        <div class="ln-tahun">2027</div>
        <div class="ln-meta-row">
          <span class="ln-umur">64 tahun</span>
          <span class="ln-ganzhi">丁未</span>
        </div>
      </div>
      <div class="ln-right">
        <div class="ln-prose">—</div>
      </div>
    </div>

    <div class="ln-card empty" data-slot="2">
      <div class="ln-left">
        <div class="ln-eyebrow">流 年</div>
        <div class="ln-tahun">2028</div>
        <div class="ln-meta-row">
          <span class="ln-umur">65 tahun</span>
          <span class="ln-ganzhi">戊申</span>
        </div>
      </div>
      <div class="ln-right">
        <div class="ln-prose">—</div>
      </div>
    </div>

    <div class="ln-card empty" data-slot="3">
      <div class="ln-left">
        <div class="ln-eyebrow">流 年</div>
        <div class="ln-tahun">2029</div>
        <div class="ln-meta-row">
          <span class="ln-umur">66 tahun</span>
          <span class="ln-ganzhi">己酉</span>
        </div>
      </div>
      <div class="ln-right">
        <div class="ln-prose">—</div>
      </div>
    </div>

    <div class="ln-card empty" data-slot="4">
      <div class="ln-left">
        <div class="ln-eyebrow">流 年</div>
        <div class="ln-tahun">2030</div>
        <div class="ln-meta-row">
          <span class="ln-umur">67 tahun</span>
          <span class="ln-ganzhi">庚戌</span>
        </div>
      </div>
      <div class="ln-right">
        <div class="ln-prose">—</div>
      </div>
    </div>

  </main>

  <!-- KAKI -->
  <footer class="footer">
    <div class="footer-meta">
      <span>Halaman {{PAGE_NUM}} / {{TOTAL_PAGES}}</span>
      <span>Ramalan 命</span>
    </div>
  </footer>

</section>
</body>
</html>
