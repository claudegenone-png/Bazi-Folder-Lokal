                '.insight-tags{display:none!important;}\n'
                '.insight-body{font-size:7.8pt!important;line-height:1.55!important;}\n'
                '.industri-list{height:auto!important;overflow:visible!important;}\n'
            )
            content = content.replace('</style>', layout_css + '</style>', 1)

            # Replace avoid-strip with foto-direct from shiye_short (if available)
            if shiye_short:
                avoid_match = re.search(r'忌\s*([^,。]+)', shiye_short)
                avoid_hz = avoid_match.group(1).strip() if avoid_match else None
                if avoid_hz:
                    new_avoid_text = (
                        f'Hindari industri ber-unsur <span class="hz">{avoid_hz}</span> '
                        f'(sumber: foto 適業 dari modul 先天論命). Bidang dengan unsur ini '
                        f'akan menambah dominasi yang sudah kuat dan menyebabkan energi macet.'
                    )
                    content = re.sub(
                        r'<div class="avoid-text">[\s\S]*?</div>',
                        f'<div class="avoid-text">{new_avoid_text}</div>',
                        content, count=1
                    )

        if fav and sup:
            def _badges(items):
                return "\n".join(
                    f'          <span class="ind-badge"><span class="hz">{i["hz"]}</span>'
                    f'<span class="id">{i["id"]}</span></span>'
                    for i in items
                )
            new_grid = (
                '<div class="industri-list industri-grid">\n'
                f'        <div class="ig-section fav">\n'
                f'          <div class="ig-header">✓ Searah · {len(fav)} bidang</div>\n'
                f'          <div class="ig-badges">\n{_badges(fav)}\n          </div>\n'
                f'        </div>\n'
                f'        <div class="ig-section sup">\n'
                f'          <div class="ig-header">◎ Pendukung · {len(sup)} bidang</div>\n'
                f'          <div class="ig-badges">\n{_badges(sup)}\n          </div>\n'
                f'        </div>\n'
                '      </div>'
            )
            content = re.sub(
                r'<div class="industri-list">[\s\S]*?</div>\s*</div>\s*(?=<!-- AVOID -->)',
                new_grid + '\n    ',
                content, count=1
            )
            # Inject CSS for badge grid
            grid_css = (
                '\n.industri-grid{display:flex;flex-direction:column;gap:2mm;'
                'padding:2mm 0;height:auto!important;overflow:visible;}\n'
                '.ig-section{display:flex;flex-direction:column;gap:1mm;}\n'
                '.ig-header{font-family:"Noto Serif TC",serif;font-size:8pt;'
                'font-weight:700;letter-spacing:1.2px;padding:1mm 2mm;'
                'border-radius:1.5mm;}\n'
                '.ig-section.fav .ig-header{background:rgba(90,140,74,0.12);'
