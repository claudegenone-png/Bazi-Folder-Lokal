PHASE_ID_LATIN = {
    "長生": "CHANG SHENG", "沐浴": "MU YU", "冠帶": "GUAN DAI",
    "臨官": "LIN GUAN", "帝旺": "DI WANG", "衰": "SHUAI",
    "病": "BING", "死": "SI", "墓": "MU", "絕": "JUE",
    "胎": "TAI", "養": "YANG"
}


def apply_v7_page04(content: str, subject: dict) -> str:
    """V7 Page 04 enrichment: 藏干+ten god, 12 phase, 命宮+空亡 chips, 八字秤骨 strip."""
    # 1) 藏干 + 十神 per pilar
    cs_dict = subject.get("canggan_shi_shen") or {}
    for pos in ("year", "month", "day", "hour"):
        entries = cs_dict.get(pos) or []
        if entries:
            inner = "".join(
                f'<span class="stem">{e["stem"]}</span><span class="tg">{e["ten_god"]}</span>'
                for e in entries
            )
            new_div = f'<div class="t-canggan" data-pos="{pos}">{inner}</div>'
        else:
            new_div = f'<div class="t-canggan empty" data-pos="{pos}"></div>'
        content = re.sub(
            rf'<div class="t-canggan[^"]*" data-pos="{pos}">.*?</div>',
            new_div, content, count=1, flags=re.DOTALL
        )

    # 2) 12 長生 phase per pilar
    cs_p = subject.get("chang_sheng_per_pilar") or {}
    for pos in ("year", "month", "day", "hour"):
        phase = cs_p.get(pos)
        if phase:
            label = PHASE_ID_LATIN.get(phase, "")
            new_div = f'<div class="t-phase" data-pos="{pos}"><span class="hz">{phase}</span>{label}</div>'
        else:
            new_div = f'<div class="t-phase empty" data-pos="{pos}"></div>'
        content = re.sub(
            rf'<div class="t-phase[^"]*" data-pos="{pos}">.*?</div>',
            new_div, content, count=1, flags=re.DOTALL
        )

    # 3) Subject-extras: 命宮 + 空亡
    chips = []
    mg = subject.get("ming_gong_bazi")
    if mg:
        chips.append(f'<span class="ext-chip mg"><span class="hz">命宮</span>{mg}</span>')
    kw = subject.get("kong_wang")
    if kw:
        chips.append(f'<span class="ext-chip kw"><span class="hz">空亡</span>{kw}</span>')
    if chips:
        extras_html = '<div class="subject-extras">\n        ' + '\n        '.join(chips) + '\n      </div>'
    else:
        extras_html = '<div class="subject-extras"></div>'
    content = re.sub(
        r'<div class="subject-extras">.*?</div>',
        extras_html, content, count=1, flags=re.DOTALL
    )

    # 4) 八字秤骨 (bone weighing) strip
    bw = subject.get("bone_weight") or {}
    if bw and bw.get("bone_weight_total"):
        total = bw.get("bone_weight_total", EM_DASH)
        y = bw.get("bone_weight_year", EM_DASH)
        m = bw.get("bone_weight_month", EM_DASH)
        d = bw.get("bone_weight_day", EM_DASH)
        h = bw.get("bone_weight_hour", EM_DASH)
        poem_hz = bw.get("bone_weight_poem_hz", "")
        poem_id = bw.get("bone_weight_poem_id", "")
        new_strip = (
            '<div class="bone-strip">\n'
            '      <div class="bone-title-block">\n'
            '        <div class="bone-eyebrow">八 字 秤 骨</div>\n'
            '        <div class="bone-title-hz">秤 骨</div>\n'
            f'        <div class="bone-total">{total}</div>\n'
            '      </div>\n'
            '      <div class="bone-weights">\n'
            f'        <div class="bw-item"><span class="bw-pillar">年</span><span class="bw-val">{y}</span></div>\n'
            f'        <div class="bw-item"><span class="bw-pillar">月</span><span class="bw-val">{m}</span></div>\n'
            f'        <div class="bw-item"><span class="bw-pillar">日</span><span class="bw-val">{d}</span></div>\n'
            f'        <div class="bw-item"><span class="bw-pillar">時</span><span class="bw-val">{h}</span></div>\n'
            '      </div>\n'
            '      <div class="bone-poem">\n'
            f'        <div class="bp-hz">{poem_hz}</div>\n'
            f'        <div class="bp-id">{poem_id}</div>\n'
            '      </div>\n'
            '    </div>'
        )
    else:
        new_strip = '<div class="bone-strip empty"></div>'
    # Anchor regex on the unique inner element bp-id, then count 3 closing divs
    # (bp-id close → bone-poem close → bone-strip close).
    content = re.sub(
        r'<div class="bone-strip[^"]*">.*?<div class="bp-id">[^<]*</div>\s*</div>\s*</div>',
        new_strip,
        content, count=1, flags=re.DOTALL
    )
    return content


def apply_v7_liunian(content: str, subject: dict) -> str:
    """V7 Phase 2A — render liu_nian prediksi cards.
    Replaces 5 placeholder cards with foto-based prose. Cards beyond data count stay empty (hidden via .empty)."""
    items = subject.get("liu_nian_predictions") or []
    # Replace each slot 0..4 with data or empty
    for slot in range(5):
        if slot < len(items):
            it = items[slot]
            tahun = it.get("tahun", "—")
            umur = it.get("umur", "—")
            ganzhi = it.get("ganzhi", "—")
            prose_raw = it.get("prose", EM_DASH)
            prose = _md_inline(prose_raw) if prose_raw and prose_raw != EM_DASH else prose_raw
            new_card = (
                f'<div class="ln-card" data-slot="{slot}">\n'
                '      <div class="ln-left">\n'
                '        <div class="ln-eyebrow">流 年</div>\n'
                f'        <div class="ln-tahun">{tahun}</div>\n'
                '        <div class="ln-meta-row">\n'
                f'          <span class="ln-umur">{umur} tahun</span>\n'
                f'          <span class="ln-ganzhi">{ganzhi}</span>\n'
                '        </div>\n'
                '      </div>\n'
                '      <div class="ln-right">\n'
                f'        <div class="ln-prose">{prose}</div>\n'
                '      </div>\n'
                '    </div>'
            )
        else:
            new_card = f'<div class="ln-card empty" data-slot="{slot}"></div>'
        # Match the slot card (greedy through closing 4 divs of card structure)
        content = re.sub(
            rf'<div class="ln-card[^"]*" data-slot="{slot}">.*?<div class="ln-prose">[^<]*</div>\s*</div>\s*</div>',
            new_card,
            content, count=1, flags=re.DOTALL
        )
        # Fallback for already-empty cards (no inner)
        content = re.sub(
            rf'<div class="ln-card empty" data-slot="{slot}"></div>',
            new_card if slot >= len(items) else new_card,
            content, count=1
        )
    return content


def apply_v7_lampiran(content: str, subject: dict) -> str:
    """V7 Phase 8 — render Lampiran Klasik page (八字秤骨 + 古書云 + 凶年).
    Per-block hide rule: kalau data block null → block di-hidden via .empty class."""
    pillars = subject.get("pillars") or {}
    bw = subject.get("bone_weight") or {}

    # === BLOCK 1: 八字秤骨 ===
    from lookups import STEMS, BRANCHES
    has_bone = bool(bw.get("bone_weight_total"))
    def _pilar_id(stem_hz, branch_hz):
        s = STEMS.get(stem_hz, {}); b = BRANCHES.get(branch_hz, {})
        if not s or not b: return ""
        return f"{s.get('el_id','')} {s.get('polarity_id','')} · {b.get('shio_id','')}"
    def _parse_liang_qian(total_hz):
        cn_num = {"零":0,"一":1,"二":2,"三":3,"四":4,"五":5,"六":6,"七":7,"八":8,"九":9,"十":10}
        liang = qian = 0
        if "兩" in total_hz:
            pre, _, rest = total_hz.partition("兩")
            for ch in pre:
                if ch in cn_num: liang = liang*10 + cn_num[ch] if liang else cn_num[ch]
        else:
            rest = total_hz
        if "錢" in rest:
            pre, _, _ = rest.partition("錢")
            for ch in pre:
                if ch in cn_num: qian = qian*10 + cn_num[ch] if qian else cn_num[ch]
        return liang, qian
    def _total_id(total_hz):
        # Legacy slot — no longer used in template, kept for compatibility
        return ""
    def _total_mixed(total_hz):
        if not total_hz: return ""
        liang, qian = _parse_liang_qian(total_hz)
        parts = []
        if liang: parts.append(f'<span class="num">{liang}</span>兩')
        if qian:  parts.append(f'<span class="num">{qian}</span>錢')
        return " ".join(parts)
    def _bone_grade_sentence(total_hz):
        if not total_hz: return ""
        liang, qian = _parse_liang_qian(total_hz)
        decimal = liang + qian/10
        if decimal < 3:
            return "Total bobot subjek **di bawah 3 兩** — nasib berat, perlu kerja keras berlipat dan dukungan dari mentor atau keluarga."
        if decimal < 4:
            return "Total bobot subjek **di rentang 3 — 4 兩** — nasib biasa, naik-turun mengikuti zaman, bergantung pada usaha pribadi."
        if decimal < 5:
            return f"Total bobot subjek **{liang} 兩 {qian} 錢** masuk rentang **4 — 5 兩** — nasib stabil, rezeki cukup, hidup relatif tenang dengan usaha wajar."
        if decimal < 6:
            return f"Total bobot subjek **{liang} 兩 {qian} 錢** masuk rentang **5 — 6 兩** — nasib makmur, dihormati banyak orang, banyak pendukung di sekitar."
        if decimal < 7:
            return f"Total bobot subjek **{liang} 兩 {qian} 錢** masuk rentang **6 — 7 兩** — nasib mulia, pengaruh besar di lingkungannya, posisi terhormat."
        return f"Total bobot subjek **{liang} 兩 {qian} 錢** mencapai **≥ 7 兩** — nasib luar biasa, sangat langka, posisi puncak dalam bidangnya."
    py = pillars.get("year",  {}); pm = pillars.get("month", {})
    pd = pillars.get("day",   {}); ph = pillars.get("hour",  {})
    bone = {
        "year_pilar":     (py.get("stem_hz","") + py.get("branch_hz","")) or "—",
        "month_pilar":    (pm.get("stem_hz","") + pm.get("branch_hz","")) or "—",
        "day_pilar":      (pd.get("stem_hz","") + pd.get("branch_hz","")) or "—",
        "hour_pilar":     (ph.get("stem_hz","") + ph.get("branch_hz","")) or "—",
        "year_pilar_id":  _pilar_id(py.get("stem_hz",""), py.get("branch_hz","")),
        "month_pilar_id": _pilar_id(pm.get("stem_hz",""), pm.get("branch_hz","")),
        "day_pilar_id":   _pilar_id(pd.get("stem_hz",""), pd.get("branch_hz","")),
        "hour_pilar_id":  _pilar_id(ph.get("stem_hz",""), ph.get("branch_hz","")),
        "year_weight":  bw.get("bone_weight_year")  or "—",
        "month_weight": bw.get("bone_weight_month") or "—",
        "day_weight":   bw.get("bone_weight_day")   or "—",
        "hour_weight":  bw.get("bone_weight_hour")  or "—",
        "total":        bw.get("bone_weight_total") or "—",
        "total_id":     _total_id(bw.get("bone_weight_total") or ""),
        "total_mixed":  _total_mixed(bw.get("bone_weight_total") or ""),
    }
    poem_hz_raw = bw.get("bone_weight_poem_hz") or ""
    poem_id_raw = bw.get("bone_weight_poem_id") or ""
    def _split_lines(s):
        return [ln.strip() for ln in s.replace("，","|").replace(";","|").replace("；","|").split("|") if ln.strip()]
    poem_hz_lines = _split_lines(poem_hz_raw)
    poem_id_lines = _split_lines(poem_id_raw)
    poem_html    = "".join(f"<span>{_md_inline(ln)}</span>" for ln in poem_hz_lines) if poem_hz_lines else ""
    poem_id_html = "".join(f"<span>{_md_inline(ln)}</span>" for ln in poem_id_lines) if poem_id_lines else ""

    content = content.replace("{{BONE_YEAR_PILAR}}",  bone["year_pilar"])
    content = content.replace("{{BONE_MONTH_PILAR}}", bone["month_pilar"])
    content = content.replace("{{BONE_DAY_PILAR}}",   bone["day_pilar"])
    content = content.replace("{{BONE_HOUR_PILAR}}",  bone["hour_pilar"])
    content = content.replace("{{BONE_YEAR_PILAR_ID}}",  bone["year_pilar_id"])
    content = content.replace("{{BONE_MONTH_PILAR_ID}}", bone["month_pilar_id"])
    content = content.replace("{{BONE_DAY_PILAR_ID}}",   bone["day_pilar_id"])
    content = content.replace("{{BONE_HOUR_PILAR_ID}}",  bone["hour_pilar_id"])
    content = content.replace("{{BONE_YEAR_WEIGHT}}",  bone["year_weight"])
    content = content.replace("{{BONE_MONTH_WEIGHT}}", bone["month_weight"])
    content = content.replace("{{BONE_DAY_WEIGHT}}",   bone["day_weight"])
    content = content.replace("{{BONE_HOUR_WEIGHT}}",  bone["hour_weight"])
    content = content.replace("{{BONE_TOTAL}}",        bone["total"])
    content = content.replace("{{BONE_TOTAL_ID}}",     bone["total_id"])
    content = content.replace("{{BONE_TOTAL_MIXED}}",  bone["total_mixed"])
    # Grade sentence (markdown bold → HTML strong)
    grade_sent = _bone_grade_sentence(bw.get("bone_weight_total") or "")
    grade_html = re.sub(r"\*\*(.+?)\*\*", r"<strong>\1</strong>", grade_sent)
    content = content.replace("{{BONE_GRADE_SENTENCE}}", grade_html)
    content = content.replace("{{BONE_POEM_HTML}}",    poem_html)
    content = content.replace("{{BONE_POEM_ID_HTML}}", poem_id_html)
    if not has_bone:
        content = content.replace('<div class="lp-bone" data-slot="bone">',
                                  '<div class="lp-bone empty" data-slot="bone">', 1)

    # === BLOCK 2: 古書云 ===
    quotes = subject.get("gushu_quotes") or []
    if quotes:
        parts = []
        for q in quotes:
            src_hz = q.get("source_hz") or q.get("source") or "—"
            src_id = q.get("source_id") or ""
            _txt_hz_raw = q.get("text_hz")   or q.get("text")   or EM_DASH
            _txt_id_raw = q.get("text_id")   or ""
            txt_hz = _md_inline(_txt_hz_raw) if _txt_hz_raw and _txt_hz_raw != EM_DASH else _txt_hz_raw
            txt_id = _md_inline(_txt_id_raw) if _txt_id_raw else _txt_id_raw
            src_block = f'<div class="lp-quote-source">{src_hz}'
            if src_id:
                src_block += f'<div class="lp-quote-source-id">{src_id}</div>'
            src_block += "</div>"
            body = f'<div class="lp-quote-body"><div class="lp-quote-text">{txt_hz}</div>'
            if txt_id:
                body += f'<div class="lp-quote-text-id">{txt_id}</div>'
            body += "</div>"
            parts.append(f'        <div class="lp-quote">{src_block}{body}</div>')
        quotes_html = "\n".join(parts)
    else:
        quotes_html = ""
    content = content.replace("{{QUOTES_HTML}}", quotes_html)
    if not quotes:
        content = content.replace('<div class="lp-quotes" data-slot="quotes">',
                                  '<div class="lp-quotes empty" data-slot="quotes">', 1)

    # === BLOCK 3: 凶年 ===
    xn = subject.get("xiongnian_list") or []
    xn_html = "\n".join(f'        <span class="lp-xn-badge">Umur {a}</span>' for a in xn) if xn else ""
    content = content.replace("{{XIONGNIAN_HTML}}", xn_html)
    if not xn:
        content = content.replace('<div class="lp-xiongnian" data-slot="xiongnian">',
                                  '<div class="lp-xiongnian empty" data-slot="xiongnian">', 1)

    return content


def apply_blocks(content: str, subject: dict, fname: str = "") -> str:
    """Block-level regeneration of complex structures.
    fname: source template filename, used to scope page-specific replacements.
    """
    # DM Score Strip (page_profile only) — pos/neg scores from MD foto 批命備註
    if fname == "page_profile.html":
        new_dms = regen_dm_score_strip(subject)
        content = replace_block(content, r'<div class="dm-score-strip">', new_dms)
        # V7 Page 04 enrichment: canggan+ten god, 12 phase, extras chips, bone strip
        content = apply_v7_page04(content, subject)

    # V7 Phase 2A — Liu Nian prediksi page
    if fname == "page_liunian.html":
        content = apply_v7_liunian(content, subject)

    # V7 Phase 8 — Lampiran Klasik (八字秤骨 + 古書云 + 凶年)
    if fname == "page_16_lampiran.html":
        content = apply_v7_lampiran(content, subject)

    # V7 Phase 4 — Full industri list di Page 12 Karir (foto-source: 事業 layar)
    if fname == "page_career.html":
        fav = subject.get("shiye_favorable_full") or []
        sup = subject.get("shiye_supportive_full") or []
        shiye_short = subject.get("shiye_short")

        # V7 Phase 4B — Layout overhaul ONLY if V7 foto-source fields present.
        # Kalau subjek tidak ada V7 data → fall back ke V4.5 layout (2-col + tags + default avoid).
        v7_career_active = bool(fav and sup)

        if v7_career_active:
            layout_css = (
                '\n/* V7 Phase 4B layout overhaul (conditional on foto-source data) */\n'
                '.career-main{grid-template-columns:1fr!important;'
                'grid-template-rows:auto auto!important;gap:3mm!important;}\n'
