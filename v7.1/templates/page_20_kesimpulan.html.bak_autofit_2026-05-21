<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<title>Kesimpulan</title>
<link rel="stylesheet" href="style.css">
<style>
  .content-pal { grid-template-rows: 1fr !important; gap: 0; }

  .kes-narr {
    background: linear-gradient(180deg, #FFF8E1, #FBF1D4);
    border: 0.6mm solid var(--gold);
    border-radius: 2.5mm;
    padding: 6mm 8mm;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 3mm;
    overflow: hidden;
    position: relative;
  }
  .kes-narr::before {
    content: ''; position: absolute;
    top: 0; right: 0; width: 28mm; height: 28mm;
    background-color: transparent;
    background-image: radial-gradient(circle at top right, rgba(201,169,97,0.22) 0%, transparent 60%);
    pointer-events: none;
  }
  .kn-head {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: baseline;
    gap: 4mm;
    border-bottom: 0.3mm solid var(--gold);
    padding-bottom: 2.5mm;
  }
  .kn-title-id {
    font-family: 'Playfair Display', serif;
    font-size: 22pt;
    color: var(--red);
    font-weight: 700;
    letter-spacing: 0.5px;
    line-height: 1;
  }
  .kn-title-hz {
    font-family: 'Noto Serif TC', serif;
    font-size: 20pt;
    color: var(--text);
    font-weight: 700;
    letter-spacing: 4px;
    line-height: 1;
  }
  .kn-title-pinyin {
    font-family: 'Inter', sans-serif;
    font-size: 8pt;
    color: var(--text-muted);
    font-style: italic;
    letter-spacing: 0.5px;
    margin-top: 1mm;
  }
  .kn-badge {
    font-family: 'Inter', sans-serif;
    font-size: 7pt;
    color: white;
    background: var(--red);
    padding: 1mm 3mm;
    border-radius: 1mm;
    letter-spacing: 1px;
    text-transform: uppercase;
    font-weight: 600;
  }
  .kn-body {
    font-size: 11pt;
    line-height: 1.55;
    color: var(--text);
    overflow: hidden;
    text-align: justify;
    padding: 0 1mm;
  }
  .kn-body p {
    margin: 0 0 2.4mm 0;
  }
  .kn-body p:last-child {
    margin-bottom: 0;
  }
  .kn-body strong {
    color: var(--red);
    font-weight: 700;
  }
  .kn-body .hz {
    font-family: 'Noto Serif TC', serif;
    color: var(--red);
    font-weight: 600;
  }
</style>
</head>
<body>
<section class="page">
  <header class="page-header">
    <div class="h-num">{{PAGE_NUM_PADDED}}</div>
    <div class="h-titles"><div class="h-cn">總 結</div><div class="h-id">Kesimpulan &amp; Gambaran Besar</div></div>
    <div class="h-section">Bagian III · Penutup</div>
  </header>

  <div class="subject-bar">
    <div class="subject-shio"><img src="Babi-Merah.svg" alt="Babi"></div>
    <div class="subject-meta">
      <div class="subject-name">Lin Ru Yi · <span style="font-family:'Noto Serif TC',serif;color:var(--red)">亥 Babi</span></div>
      <div class="subject-detail">Rangkuman narasi lengkap profil &amp; nasib</div>
    </div>
    <div class="subject-dm"><div class="label">Penguasa Hari</div><div class="value">辛金 · Logam Halus</div></div>
  </div>

  <main class="content content-pal">
    <div class="kes-narr">
      <div class="kn-head">
        <div>
          <div class="kn-title-id">Kesimpulan</div>
          <div class="kn-title-pinyin">Zǒng Jié</div>
        </div>
        <div style="text-align:center;">
          <div class="kn-title-hz">總 結</div>
        </div>
        <div class="kn-badge">Gambaran Besar</div>
      </div>

      <div class="kn-body"><!-- TAFSIR:_kes_narrative --><p>—</p><!-- /TAFSIR --></div>
    </div>
  </main>

  <footer class="footer">
    <div class="footer-meta"><span>Halaman {{PAGE_NUM}} / {{TOTAL_PAGES}}</span></div>
  </footer>
</section>
<script>
  // AUTO-SHRINK + STRONG STYLING: kalau .kn-body overflow .kes-narr, shrink font sampai fit.
  (function() {
    function fit() {
      var body = document.querySelector('.kes-narr .kn-body');
      var card = document.querySelector('.kes-narr');
      if (!body || !card) return;
      var sizePt = 9, lh = 1.55, minPt = 6.0, guard = 0;
      function overflowing() { return card.scrollHeight > card.clientHeight + 1; }
      while (overflowing() && sizePt > minPt && guard < 60) {
        sizePt -= 0.2;
        lh = Math.max(1.25, lh - 0.01);
        body.style.fontSize = sizePt.toFixed(2) + 'pt';
        body.style.lineHeight = lh.toFixed(2);
        var ps = body.querySelectorAll('p');
        for (var i = 0; i < ps.length; i++) {
          ps[i].style.fontSize = sizePt.toFixed(2) + 'pt';
          ps[i].style.lineHeight = lh.toFixed(2);
        }
        guard++;
      }
    }
    if (document.readyState === 'complete' || document.readyState === 'interactive') fit();
    else document.addEventListener('DOMContentLoaded', fit);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(fit);
  })();
</script>
</body>
</html>
